# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API (admin dashboard)
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase (service role key — server side ONLY, never ship to clients)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Firebase Admin (service account). Paste the private key with literal \n.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-firebase-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Razorpay
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
# Plan created in the Razorpay dashboard (Subscriptions → Plans)
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxxxx
# Number of billing cycles the subscription is authorised for (e.g. 12 monthly charges)
RAZORPAY_TOTAL_COUNT=12
# Display values for the checkout sheet
RAZORPAY_PLAN_DISPLAY_AMOUNT_PAISE=19900
RAZORPAY_PLAN_DISPLAY_INTERVAL=month
RAZORPAY_BRAND_NAME=EduShorts

# ---------------------------------------------------------------------------
# Bunny Stream
# ---------------------------------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=123456
# Stream library API key (Stream → Library → API)
BUNNY_STREAM_API_KEY=your-stream-library-api-key
# Pull zone hostname of the library, e.g. vz-abc12345-678.b-cdn.net
BUNNY_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net
# Optional: pull-zone Token Authentication key. When set, HLS URLs are signed.
BUNNY_CDN_TOKEN_KEY=
# Optional: Stream library "Embed view token authentication" key. When set, embed URLs are signed.
BUNNY_EMBED_TOKEN_KEY=
# Lifetime of signed playback URLs, in seconds
BUNNY_URL_TTL_SECONDS=3600
