# Base URL of the EduShorts Express API (use your LAN IP when testing on a device)
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Public link used by the Share button (https://<domain>/reel/<id>)
EXPO_PUBLIC_SHARE_BASE_URL=https://edushorts.app/reel

# Firebase web app config (Firebase console → Project settings → Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
